# ============================================================
# .env.production — JANGAN commit file ini ke git!
# Salin dari .env.example lalu isi dengan nilai production
# ============================================================

# ─── Database MySQL ───────────────────────────────────────
# Untuk MySQL dalam Docker: DB_HOST=db
# Untuk MySQL external:     DB_HOST=ip-atau-hostname-server
DB_HOST=db
DB_PORT=3306
DB_USER=adminit2025
DB_PASSWORD=dbwoit2025
DB_NAME=dbwoit

# ─── MySQL container ──────────────────────────────────────
MYSQL_ROOT_PASSWORD=GANTI_ROOT_PASSWORD_PRODUCTION_YANG_KUAT

# ─── Security ─────────────────────────────────────────────
# Generate: openssl rand -base64 32
JWT_SECRET=GANTI_DENGAN_RANDOM_STRING_PRODUCTION

# ─── Internal service key ─────────────────────────────────
# Generate: openssl rand -hex 32
INTERNAL_API_KEY=GANTI_DENGAN_RANDOM_HEX_PRODUCTION
