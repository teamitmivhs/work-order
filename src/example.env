# ============================================================
# .env.example — copy ke .env lalu isi nilainya
# JANGAN commit file .env ke git!
# ============================================================

# ─── Database MySQL ───────────────────────────────────────
# Untuk docker-compose.yml / docker-compose.persistent.yml:
#   DB_HOST tidak perlu diubah (otomatis "db" dari compose)
# Untuk docker-compose.external-db.yml:
#   Isi DB_HOST dengan IP/hostname MySQL server eksternal
DB_HOST=localhost
DB_PORT=3306
DB_USER=adminit2025
DB_PASSWORD=dbwoit2025
DB_NAME=dbwoit

# ─── MySQL container (docker-compose.yml / persistent) ───
MYSQL_ROOT_PASSWORD=ganti_dengan_root_password_aman

# ─── Security ─────────────────────────────────────────────
# Generate dengan: openssl rand -base64 32
JWT_SECRET=ganti_dengan_random_string_minimal_32_karakter

# ─── Internal service key ─────────────────────────────────
# Shared secret antara Go backend dan Rust time-tracker
# Generate dengan: openssl rand -hex 32
INTERNAL_API_KEY=ganti_dengan_random_hex_32_karakter
